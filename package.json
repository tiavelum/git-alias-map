{
  "name": "git-alias-map",
  "private": true,
  "type": "module",
  "description": "Shows how the git aliases of a gitconfig call each other and writes an editor page for reducing them.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "prettier --check . && eslint . && node scripts/module-diagram.js --check && node --test",
    "format": "prettier --write .",
    "test": "node --test",
    "diagram": "node scripts/module-diagram.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10"
  }
}
